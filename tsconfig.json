{
    "compilerOptions": {
      "rootDirs": ["src"],
      "outDir": "./dist",
      "lib": ["ESNext"],
      "target": "ESNext",
      "module": "NodeNext",
      "moduleResolution": "NodeNext",
      "esModuleInterop": true,
      "types": ["node"]
    },
    "include": ["src/**/*"],
    "exclude": ["node_modules"]
  }